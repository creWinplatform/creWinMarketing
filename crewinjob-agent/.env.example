# ─── crewinjob Marketing Agent — Ortam Değişkenleri ─────────────────────────
# Bu dosyayı kopyalayın: .env.example → .env
# .env dosyasını git'e commit ETMEYİN!

# ── Zorunlu ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-buraya-api-keyinizi-yazin

# ── Google Search Console (isteğe bağlı) ──────────────────────────────────────
# google-credentials.json dosyasını proje klasörüne ekleyin
# Kurulum: https://console.cloud.google.com → Search Console API → Servis Hesabı
GOOGLE_SITE_URL=https://crewinjob.com

# ── crewinjob API (hazır olduğunda) ───────────────────────────────────────────
# CREWINJOB_API_URL=https://crewinjob.com/api
# CREWINJOB_API_KEY=buraya-api-keyinizi-yazin
