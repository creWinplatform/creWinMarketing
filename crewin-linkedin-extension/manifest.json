{
  "manifest_version": 3,
  "name": "CrewinJob LinkedIn Auto-Post",
  "version": "1.0.0",
  "description": "CrewinJob uygulamasından LinkedIn şirket sayfasına yarı-otomatik post yayınlar.",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "externally_connectable": {
    "matches": [
      "http://localhost:3333/*",
      "http://localhost/*",
      "https://*.crewin.org/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "CrewinJob LinkedIn"
  }
}
