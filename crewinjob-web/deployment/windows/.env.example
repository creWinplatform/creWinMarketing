# Ryzevo production runtime for https://ryzevo.com (Windows EC2 behind IIS/HTTPS).
# Copy to RYZEVO_ENV_FILE on the server. Never commit real values; REPLACE_* are placeholders.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3033
NEXT_DIST_DIR=.next-production
RYZEVO_ENV_FILE=C:\ProgramData\Ryzevo\config\runtime.env

# Public origin: one HTTPS origin for the landing, sign-in and the app. www.ryzevo.com redirects here (IIS).
NEXT_PUBLIC_APP_URL=https://ryzevo.com
PLATFORM_PUBLIC_ORIGIN=https://ryzevo.com
PLATFORM_AUTH_ORIGIN=https://ryzevo.com
PLATFORM_WORKER_ORIGIN=http://127.0.0.1:3033
PLATFORM_WORKER_EXPECTED=1

# Data, backups and the legacy agent (private, durable volume; backups also copied off-host).
PLATFORM_DATABASE_PATH=C:\ProgramData\Ryzevo\data\platform.sqlite
PLATFORM_BACKUP_PATH=C:\ProgramData\Ryzevo\backups
CREWINJOB_AGENT_DIR=C:\ProgramData\Ryzevo\legacy-agent

# Secrets: separate random values per environment.
AUTH_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
CRON_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
TRACKING_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
ADMIN_PASSWORD=REPLACE_WITH_LONG_UNIQUE_PASSWORD
# Stable 64-hex key. When moving an existing database, reuse the key it was encrypted with
# (data/platform-credentials.key); a new key makes stored provider credentials unreadable.
PLATFORM_ENCRYPTION_KEY=REPLACE_WITH_STABLE_64_HEX_KEY

# Provider OAuth callbacks: register these exact URLs in each provider's developer console.
PLATFORM_GOOGLE_REDIRECT_URI=https://ryzevo.com/api/platform/google/callback
PLATFORM_LINKEDIN_REDIRECT_URI=https://ryzevo.com/api/platform/social/callback
PLATFORM_X_REDIRECT_URI=https://ryzevo.com/api/platform/x/callback
PLATFORM_META_REDIRECT_URI=https://ryzevo.com/api/platform/meta/callback

# Ryzevo's own transactional email (sign-up, verification, recovery) through Amazon SES.
PLATFORM_AUTH_FROM_EMAIL=no-reply@ryzevo.com
PLATFORM_AUTH_SES_REGION=REPLACE_WITH_SES_REGION
PLATFORM_AUTH_SES_ACCESS_KEY_ID=REPLACE_WITH_DEDICATED_SES_KEY_ID
PLATFORM_AUTH_SES_SECRET_ACCESS_KEY=REPLACE_WITH_DEDICATED_SES_SECRET
# Bounce/complaint feedback for campaign email (SNS topic subscribed to /api/track/bounce).
SES_SNS_TOPIC_ARN=REPLACE_WITH_SNS_TOPIC_ARN
SES_CONFIGURATION_SET=REPLACE_WITH_SES_CONFIGURATION_SET

# Billing: PayTR callbacks return to this origin. Live payment stays OFF until the merchant
# contract, USD approval and the published distance-sales terms page are in place.
PLATFORM_PAYTR_ORIGIN=https://ryzevo.com
PLATFORM_BILLING_TERMS_URL=REPLACE_WITH_PUBLISHED_TERMS_URL
PLATFORM_PAYTR_LIVE_ENABLED=0
PLATFORM_PAYTR_SANDBOX_ENABLED=0

# Every outbound or customer-facing feature starts OFF; enable one at a time after acceptance.
PLATFORM_EMAIL_PILOT_SEND_ENABLED=0
PLATFORM_SOCIAL_PUBLISH_ENABLED=0
PLATFORM_LINKEDIN_ANALYTICS_ENABLED=0
PLATFORM_MOBILE_SEND_ENABLED=0
PLATFORM_MOBILE_LINKS_ENABLED=0
PLATFORM_WHATSAPP_SEND_ENABLED=0
PLATFORM_COACH_DIGEST_ENABLED=0
PLATFORM_AUTH_EMAIL_ENABLED=0
PLATFORM_PUBLIC_SIGNUP_ENABLED=0
