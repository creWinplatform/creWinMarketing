NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3033
NEXT_DIST_DIR=.next-production
NEXT_PUBLIC_APP_URL=https://ryzevo.com
PLATFORM_AUTH_ORIGIN=https://ryzevo.com
PLATFORM_WORKER_ORIGIN=http://127.0.0.1:3033
PLATFORM_WORKER_EXPECTED=1
RYZEVO_ENV_FILE=C:\ProgramData\Ryzevo\config\runtime.env
PLATFORM_DATABASE_PATH=C:\ProgramData\Ryzevo\data\platform.sqlite
PLATFORM_BACKUP_PATH=C:\ProgramData\Ryzevo\backups
CREWINJOB_AGENT_DIR=C:\ProgramData\Ryzevo\legacy-agent
AUTH_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
CRON_SECRET=REPLACE_WITH_SEPARATE_RANDOM_SECRET
PLATFORM_ENCRYPTION_KEY=REPLACE_WITH_STABLE_64_HEX_KEY
PLATFORM_EMAIL_PILOT_SEND_ENABLED=0
PLATFORM_SOCIAL_PUBLISH_ENABLED=0
PLATFORM_LINKEDIN_ANALYTICS_ENABLED=0
PLATFORM_MOBILE_SEND_ENABLED=0
PLATFORM_MOBILE_LINKS_ENABLED=0
PLATFORM_AUTH_EMAIL_ENABLED=0
