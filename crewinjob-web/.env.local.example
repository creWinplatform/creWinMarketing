# ─────────────────────────────────────────────────────────────────────────────
# crewinjob Marketing Agent — Environment Variables
# Kopyala: cp .env.local.example .env.local
# .env.local dosyasını asla git'e commit etme!
# ─────────────────────────────────────────────────────────────────────────────

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# 1. https://aistudio.google.com/app/apikey adresine git
# 2. "Create API Key" → proje seç → kopyala
GEMINI_API_KEY=

# ── Uygulama URL (OAuth callback için) ───────────────────────────────────────
# Lokalde: http://localhost:3333
# Production'da: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3333


# ═══════════════════════════════════════════════════════════════════════════════
# TWITTER / X  —  Otomatik tweet (ayda 1.500 ücretsiz)
# ═══════════════════════════════════════════════════════════════════════════════
#
# KURULUM (OAuth 1.0a — en kolay yol):
# 1. https://developer.twitter.com/en/portal/dashboard → "Create Project" → "Create App"
# 2. App Settings → "User authentication settings" →
#      App permissions: "Read and Write" (ÖNEMLİ! yoksa 403 hatası alırsın)
#      Type of App: "Web App"
#      Callback URI: http://localhost:3333/api/social/callback/twitter
# 3. "Keys and Tokens" sekmesi →
#      Consumer Keys bölümünden:   API Key → TWITTER_API_KEY
#                                   API Secret → TWITTER_API_SECRET
#      Access Token bölümünden (kullanıcı adına, "Generate" ile):
#                                   Access Token → TWITTER_ACCESS_TOKEN_V1
#                                   Access Token Secret → TWITTER_ACCESS_TOKEN_SECRET
# NOT: "Read and Write" izni seçtikten SONRA token'ları yeniden oluştur!
#
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN_V1=
TWITTER_ACCESS_TOKEN_SECRET=

# OAuth 2.0 — opsiyonel, OAuth flow için
TWITTER_CLIENT_ID=
TWITTER_ACCESS_TOKEN=
TWITTER_REFRESH_TOKEN=
TWITTER_USERNAME=


# ═══════════════════════════════════════════════════════════════════════════════
# FACEBOOK  —  Sayfa paylaşımı (Graph API)
# ═══════════════════════════════════════════════════════════════════════════════
#
# KURULUM:
# 1. https://developers.facebook.com → "My Apps" → "Create App"
#      App Type: "Business"
# 2. Sol menü → "Add Products" → "Facebook Login" + "Pages API" ekle
# 3. App Settings → Basic:
#      App ID → FACEBOOK_APP_ID
#      App Secret → FACEBOOK_APP_SECRET
# 4. Page Access Token almak için:
#    a) https://developers.facebook.com/tools/explorer/
#    b) Üst sağ: "Generate Access Token" → Sayfanı seç
#    c) İzinler: pages_manage_posts, pages_read_engagement
#    d) Token'ı kopyala → FACEBOOK_PAGE_ACCESS_TOKEN
#    e) Sayfa ID'ni bul: Facebook sayfan → "About" → sayfa altındaki ID
#       veya https://findmyfbid.in → FACEBOOK_PAGE_ID
# NOT: Token 60 gün geçerli. Uzun ömürlü token için Graph API /oauth/access_token kullan.
#
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=


# ═══════════════════════════════════════════════════════════════════════════════
# INSTAGRAM  —  Business hesap (Graph API, görsel zorunlu)
# ═══════════════════════════════════════════════════════════════════════════════
#
# ÖN KOŞULLAR:
#   - Instagram hesabı "Professional / Business" olmalı
#   - Hesap bir Facebook Sayfasına bağlı olmalı
#
# KURULUM:
# 1. Facebook App kurulumu (yukarıdaki FACEBOOK adımlarını tamamla)
# 2. App'e "Instagram Graph API" ürünü ekle
# 3. Instagram User ID almak için:
#    a) Graph Explorer: https://developers.facebook.com/tools/explorer/
#    b) Sorgu: GET me/accounts → sayfa listesi çıkar
#    c) Sayfanın id'si ile: GET {page-id}?fields=instagram_business_account
#    d) Dönen "id" değeri → INSTAGRAM_IG_USER_ID
# 4. INSTAGRAM_ACCESS_TOKEN = FACEBOOK_PAGE_ACCESS_TOKEN (aynı token çalışır)
#
# GÖRSEL ZORUNLULUĞU:
#   Instagram Graph API metin-only post kabul etmez.
#   Uygulama içinde "Görsel Oluştur" butonunu kullanarak görsel üret,
#   ardından paylaş akışını başlat.
#
# IMGBB (görsel CDN — ücretsiz):
#   Instagram API base64 değil public URL istiyor, ImgBB bu görevi üstleniyor.
#   1. https://imgbb.com → Kayıt ol (ücretsiz)
#   2. https://api.imgbb.com/ → "Get API Key"
#   3. → IMGBB_API_KEY
#
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
IMGBB_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# LINKEDIN  —  Şirket sayfası paylaşımı
# ═══════════════════════════════════════════════════════════════════════════════
#
# HIZLI KURULUM (statik token — OAuth flow gerektirmez):
# 1. https://www.linkedin.com/developers/apps → "Create App"
# 2. Ürünler: "Share on LinkedIn" + "Marketing Developer Platform" ekle
# 3. "Auth" sekmesi → Client ID → LINKEDIN_CLIENT_ID
#                   → Client Secret → LINKEDIN_CLIENT_SECRET
# 4. Access Token almak için:
#    a) OAuth 2.0 flow başlat: scope=w_member_social,r_organization_admin
#    b) Postman veya https://www.linkedin.com/oauth/v2/authorization ile al
#    c) → LINKEDIN_ACCESS_TOKEN (60 gün geçerli)
# 5. Kişisel User ID: GET https://api.linkedin.com/v2/me → "id" alanı → LINKEDIN_USER_ID
# 6. Şirket Sayfası ID (isteğe bağlı):
#    GET https://api.linkedin.com/v2/organizationAcls?q=roleAssignee
#    Dönen "organization" değeri (orn:li:organization:XXXXX) → LINKEDIN_ORGANIZATION_ID
#    Boş bırakılırsa uygulama otomatik bulur.
#
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_USER_ID=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════════════════════════
# TIKTOK  —  Script Modu (API video zorunlu, otomatik post YAPILMIYOR)
# ═══════════════════════════════════════════════════════════════════════════════
#
# TikTok Content Posting API yalnızca video/görsel carousel kabul eder.
# Metin-only post mümkün değil (platform kısıtlaması).
#
# KULLANIM:
#   Uygulama TikTok için "Script Modu" ile çalışır:
#   1. İçerik Üret → SocialTab'da TikTok seç → script üret
#   2. Paylaş butonuna tıkla → Script panelinde "Scripti Kopyala"
#   3. TikTok uygulamasında video çek/seç → açıklama kutusuna yapıştır
#
# Gelecekte video yükleme entegrasyonu için gereken keyler (şimdi boş bırak):
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=


# ═══════════════════════════════════════════════════════════════════════════════
# Crewin API  —  Gerçek istatistikler
# ═══════════════════════════════════════════════════════════════════════════════
CREWINJOB_API_URL=https://api.crewin.org
CREWINJOB_API_USERNAME=
CREWINJOB_API_PASSWORD=
# Alternatif — statik JWT token (yukarıdakiler doluysa boş bırak)
CREWINJOB_API_KEY=


# ═══════════════════════════════════════════════════════════════════════════════
# WhatsApp Business Cloud API  —  Mesaj gönderimi
# ═══════════════════════════════════════════════════════════════════════════════
#
# KURULUM:
# 1. https://developers.facebook.com → App oluştur → "WhatsApp" ürünü ekle
# 2. WhatsApp → API Setup:
#      Phone Number ID → WHATSAPP_PHONE_NUMBER_ID
#      Temporary/Permanent Access Token → WHATSAPP_ACCESS_TOKEN
# 3. Test numarası veya onaylı iş numarası: WHATSAPP_FROM_NUMBER (E.164 format: +905XXXXXXXXX)
#
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_FROM_NUMBER=


# ═══════════════════════════════════════════════════════════════════════════════
# Telegram Bot API  —  Kanal ve mesaj gönderimi
# ═══════════════════════════════════════════════════════════════════════════════
#
# KURULUM:
# 1. Telegram'da @BotFather → /newbot → isim ver → TOKEN al → TELEGRAM_BOT_TOKEN
# 2. Kanalın botunu admin yap (admin olmazsa mesaj gönderemez)
# 3. Kanal ID: @kanaladi (public) veya -100XXXXXXXXXX (private, sayısal)
#    Sayısal ID için: @userinfobot'a kanalı ilet → ID'yi kopyala
#    → TELEGRAM_CHANNEL_ID
#
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
