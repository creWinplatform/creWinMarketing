<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- ARR Reverse Proxy: IIS → Node.js (port 3333) -->
    <rewrite>
      <rules>
        <rule name="ReverseProxy" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{CACHE_URL}" pattern="^(https?)://" />
          </conditions>
          <action type="Rewrite" url="http://localhost:3333/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!-- Proxy ayarları -->
    <proxy enabled="true" preserveHostHeader="false" reverseRewriteHostInResponseHeaders="false" />

    <!-- Statik dosyalar için cache -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Hata sayfalarını Node.js'e bırak -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
